# Server Config
NODE_ENV=production
PORT=3000

# Database Config (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
DB_HOST=aws-1-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_database_password
DB_SSL=true

# JWT Authentication
JWT_SECRET=your_production_jwt_secret_key
JWT_EXPIRATION=7d

# Webhook Security Key (For Phone SMS Forwarder App)
WEBHOOK_SECRET_KEY=your_webhook_secret_key

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key_here
SENDER_EMAIL=onboarding@resend.dev
